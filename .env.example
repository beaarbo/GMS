# Copy to .env for local use. On a host, set these as environment variables.

# development or production. Production requires every value below to be set.
NODE_ENV=development
PORT=3000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# The admin (host) account, created on first start if no admin exists yet.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-password

# The site's public address. Links in emails use it. Required in production.
PUBLIC_URL=http://localhost:3000

# Email, from any provider that offers SMTP. Without SMTP_HOST no email is sent,
# and in development messages are printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Game Management System <no-reply@example.test>

# Where the SQLite file lives. On a host, point this at a persistent disk.
DATABASE_PATH=./data/gms.sqlite

# Registration deadlines are checked against "today" in this time zone.
TZ=Asia/Manila
