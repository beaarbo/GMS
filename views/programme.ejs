<%- include('partials/top') %>
<% const pdfQuery = new URLSearchParams(Object.entries({ event: filters.event, club: filters.clubId ? 'mine' : null }).filter(([, v]) => v)).toString(); %>
<p class="breadcrumb"><a href="/competitions/<%= competition.id %>"><%= competition.name %></a></p>
<div class="page-head">
  <div>
    <h1>Bout list</h1>
    <p class="sub"><%= competition.name %> · <%= competition.venue %>, <%= eventDatesText(competition) %> · in running order</p>
  </div>
  <% if (parts.length > 0) { %>
    <div class="actions"><a class="btn" href="/competitions/<%= competition.id %>/bouts.pdf<%= pdfQuery ? `?${pdfQuery}` : '' %>">Download PDF</a></div>
  <% } %>
</div>

<%- include('partials/programme_nav') %>

<% if (competitors) { %>
  <%# My club: the coach's competitors in time order, before their divisions. %>
  <section class="card" id="my-club">
    <h2>Your competitors</h2>
    <% if (competitors.length === 0) { %>
      <p class="empty">None of your club's competitors are on the published bout list<%= filters.event ? ' for this event' : '' %> yet.</p>
    <% } else { %>
      <p class="sub"><%= competitors.length %> on the bout list, in the order they compete. Their divisions are below.</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Competitor</th><th>Event</th><th>Division</th><th>Day</th><th>Court</th><th>Next</th><th>Time</th><th>Poomsae</th><th>Status</th></tr></thead>
          <tbody>
            <% competitors.forEach((c) => { %>
              <tr>
                <td><strong><%= c.name %></strong></td>
                <td><%= c.event %></td>
                <td><%= c.division %></td>
                <td class="nowrap"><%= c.dayLabel %></td>
                <td class="nowrap"><%= c.court %></td>
                <td class="nowrap"><%= c.next %></td>
                <td class="nowrap"><%= c.time || '–' %></td>
                <td><%= c.poomsae ? c.poomsae.join(' · ') : '–' %></td>
                <td><%= c.status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
<% } %>

<% if (parts.length === 0) { %>
  <% if (!competitors) { %><section class="card"><p class="empty">Nothing is published for these filters yet.</p></section><% } %>
<% } else { %>
  <% const days = [...new Set(parts.map((p) => p.dayLabel || ''))]; %>
  <% if (!competitors) { %>
  <section class="card">
    <h2>Running order</h2>
    <% days.forEach((day) => { const list = parts.filter((p) => (p.dayLabel || '') === day); %>
      <h3><%= day && day !== '-' ? `Day ${day}` : 'Day to be set' %></h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Court</th><th>Starts</th><th>Event</th><th>Division</th></tr></thead>
          <tbody>
            <% list.forEach((p) => { %>
              <tr>
                <td class="nowrap"><%= p.courtLabel %></td>
                <td class="nowrap"><%= p.start || '–' %></td>
                <td><%= p.event %><%= p.kind === 'list' ? ' order' : p.kind === 'bracket' ? ' bracket' : '' %></td>
                <td><a href="#<%= p.anchor %>"><%= p.title %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>
  </section>
  <% } %>

  <% parts.forEach((p) => { %>
    <% if (p.kind === 'kyorugi') { %>
      <%- include('partials/kyorugi_division', { division: p, highlightClubId, anchor: p.anchor }) %>
    <% } else { %>
      <%- include('partials/poomsae_page', { page: p, highlightClubId, anchor: p.anchor }) %>
    <% } %>
  <% }) %>
<% } %>
<%- include('partials/bottom') %>
