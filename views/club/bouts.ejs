<%- include('../partials/top') %>
<p class="breadcrumb"><a href="/club/competitions/<%= competition.id %>"><%= competition.name %></a></p>
<div class="page-head">
  <div>
    <h1>Bout list</h1>
    <p class="sub"><%= competition.name %> · <%= competition.venue %>, <%= eventDatesText(competition) %></p>
  </div>
  <div class="actions">
    <a class="btn secondary" href="/competitions/<%= competition.id %>/bouts?club=mine">Full bout list</a>
    <a class="btn secondary" href="/screens/<%= competition.id %>">Court screens</a>
    <% if (divisions.length > 0) { %><a class="btn" href="/club/competitions/<%= competition.id %>/bouts.pdf">Download PDF</a><% } %>
  </div>
</div>

<section class="card">
  <h2>Your athletes</h2>
  <% if (athletes.length === 0) { %>
    <p class="empty">None of your club's athletes are in this bout list.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Athlete</th><th>Division</th><th>Day</th><th>Court</th><th>Next bout</th><th>Status</th></tr></thead>
        <tbody>
          <% athletes.forEach((a) => { %>
            <tr>
              <td><strong><%= a.name %></strong></td>
              <td><%= a.title %></td>
              <td class="nowrap"><%= a.dayLabel %></td>
              <td><%= a.court || '–' %></td>
              <td class="nowrap"><%= a.nextNumber ? `Bout ${a.nextNumber}, ${a.nextTime}` : '–' %></td>
              <td><%= a.status %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/medals') %>

<% divisions.forEach((division) => { %>
  <%- include('../partials/kyorugi_division', { division, highlightClubId }) %>
<% }) %>
<%- include('../partials/bottom') %>
