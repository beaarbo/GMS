<%# One competition as a card, used on the Competitions page and the coach Home page. Pass c; c.entries
    (the club's counts), c.finished and c.hasResults are optional. One main button for where the
    competition is: enter athletes, the bout list, or the results. %>
<% const cardOpen = isRegistrationOpen(c); %>
<% const clubCoach = user && user.club_id; %>
<% const e = c.entries; %>
<% const entered = e ? e.pending + e.approved + e.rejected : 0; %>
<article class="card">
  <div class="title-row">
    <%- include('comp_logo', { competition: c, size: 'md' }) %>
    <span class="badge <%= cardOpen ? 'open' : 'closed' %>"><%= c.finished ? 'Finished' : cardOpen ? `Open · ${timeLeft(c)}` : 'Registration closed' %></span>
  </div>
  <h3 class="card-title"><a class="title-link" href="/competitions/<%= c.id %>"><%= c.name %></a></h3>
  <p class="sub"><%= eventDatesText(c) %> · <%= c.venue %></p>
  <% if (cardOpen) { %><p class="sub">Registration deadline: <%= deadlineText(c) %></p><% } %>
  <%# Up to four of the competition's photos; the last says how many more are on its page. %>
  <% if (c.photos && c.photos.length > 0) { const shown = c.photos.slice(0, 4); const more = c.photos.length - shown.length; %>
    <div class="card-photos">
      <% shown.forEach((photo, i) => { %>
        <% if (more > 0 && i === shown.length - 1) { %><a href="/competitions/<%= c.id %>#photos" class="more" data-more="+<%= more %>" aria-label="See all <%= c.photos.length %> photos of <%= c.name %>"><% } else { %><a href="/competitions/<%= c.id %>#photos"><% } %><img src="/competitions/<%= c.id %>/photos/<%= photo.id %>" alt="<%= c.name %>, photo <%= i + 1 %> of <%= c.photos.length %>" loading="lazy"></a>
      <% }) %>
    </div>
  <% } %>
  <% if (clubCoach && e) { %>
    <p class="stats card-stats">
      <% if (entered === 0) { %>
        <span>No athletes entered yet</span>
      <% } else { %>
        <span>Approved <strong><%= e.approved %></strong></span>
        <span>Pending <strong><%= e.pending %></strong></span>
        <% if (e.rejected > 0) { %><span>Rejected <strong><%= e.rejected %></strong></span><% } %>
      <% } %>
    </p>
  <% } %>
  <%# The bout list and results cover kyorugi and poomsae together; a coach with entries sees their club's first. %>
  <% const published = c.bouts_published_at || c.poomsae_published_at || c.poomsae_brackets_published_at; %>
  <% const mine = clubCoach && entered > 0 ? '?club=mine' : ''; %>
  <% const entriesLink = ['Your entries', `/club/competitions/${c.id}`]; %>
  <% const main = c.finished ? (c.hasResults || published ? ['Results', `/competitions/${c.id}/results${mine}`] : null)
    : clubCoach && cardOpen ? ['Enter athletes', `/club/competitions/${c.id}`]
    : published ? [mine ? 'Our bouts' : 'Bout list', `/competitions/${c.id}/bouts${mine}`]
    : clubCoach && entered > 0 ? entriesLink : null; %>
  <% const more = [
    clubCoach && entered > 0 && main !== entriesLink && !(cardOpen && !c.finished) ? entriesLink : null,
    !c.finished && c.hasResults ? ['Results', `/competitions/${c.id}/results${mine}`] : null,
    ['Details', `/competitions/${c.id}`],
  ].filter(Boolean); %>
  <div class="actions">
    <% if (main) { %><a class="btn" href="<%= main[1] %>"><%= main[0] %></a><% } %>
    <% more.forEach(([label, href]) => { %><a class="btn secondary" href="<%= href %>"><%= label %></a><% }) %>
  </div>
</article>
