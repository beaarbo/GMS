<%# Club medal table. Pass medals ({ table }), and optionally medalTitle and medalHint. %>
<section class="card">
  <h2><%= typeof medalTitle === 'undefined' ? 'Medal standings' : medalTitle %></h2>
  <% if (medals.table.length === 0) { %>
    <p class="empty">No medals yet.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Club</th><th class="medal-count">Gold</th><th class="medal-count">Silver</th><th class="medal-count">Bronze</th></tr></thead>
        <tbody>
          <% medals.table.forEach((row) => { %>
            <tr>
              <td><span class="club-name"><%- include('club_icon', { clubId: row.clubId, name: row.club, size: 'sm' }) %><strong><%= row.club %></strong></span></td>
              <td class="medal-count"><%= row.gold %></td>
              <td class="medal-count"><%= row.silver %></td>
              <td class="medal-count"><%= row.bronze %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="hint"><%= typeof medalHint === 'undefined' ? "Each losing semifinalist gets bronze. Athletes alone in a division aren't counted." : medalHint %></p>
  <% } %>
</section>
