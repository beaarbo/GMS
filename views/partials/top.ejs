<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Game Management System</title>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <div class="corner-stripe"></div>
  <div class="topbar-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Game Management System</a>
    <%
      // Marks the section the visitor is in. Admin sub-pages belong to the dashboard.
      const current = (href) => {
        if (href === '/') return currentPath === '/' || currentPath.startsWith('/competitions');
        if (href === '/news') return currentPath === '/news' || currentPath.startsWith('/news/') || currentPath.startsWith('/admin/news');
        if (href === '/admin') return currentPath === '/admin' || currentPath.startsWith('/admin/competitions') || currentPath.startsWith('/admin/fighters');
        return currentPath === href || currentPath.startsWith(`${href}/`);
      };
      const link = (href, label) => `<a href="${href}"${current(href) ? ' aria-current="page"' : ''}>${label}</a>`;
    %>
    <nav class="nav" aria-label="Main">
      <%- link('/', 'Competitions') %>
      <%- link('/news', 'News') %>
      <% if (user && user.role === 'admin') { %>
        <%- link('/admin', 'Dashboard') %>
        <%- link('/admin/clubs', 'Clubs and coaches') %>
        <%- link('/admin/accounts', 'Accounts') %>
        <%- link('/admin/activity', 'Activity log') %>
      <% } else if (user && user.club_id) { %>
        <%- link('/club', 'Club dashboard') %>
      <% } else if (user) { %>
        <%- link('/coach', 'Join a club') %>
      <% } %>
      <% if (user) { %>
        <a class="who" href="/account" title="My account"<%- currentPath.startsWith('/account') ? ' aria-current="page"' : '' %>><% if (user.club_id) { %><%- include('club_icon', { clubId: user.club_id, name: user.club_name, size: 'sm' }) %><% } %><%= user.full_name || user.email %><%= user.club_name ? ` · ${user.club_name}` : '' %></a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="link-button" type="submit">Log out</button>
        </form>
      <% } else { %>
        <%- link('/login', 'Log in') %>
        <%- link('/register', 'Coach sign up') %>
      <% } %>
    </nav>
  </div>
</header>
<main>
<% flash.forEach((item) => { %>
  <div class="notice <%= item.type %>" role="status"><%= item.text %></div>
<% }) %>
