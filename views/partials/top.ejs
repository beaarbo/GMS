<!doctype html>
<html lang="en"<%- user ? ` data-account-theme="${user.theme}"${user.theme !== 'auto' ? ` data-theme="${user.theme}"` : ''}` : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= site.siteName %></title>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <div class="corner-stripe"></div>
  <div class="topbar-inner">
    <a class="brand" href="/"><% if (siteLogoUrl()) { %><img class="brand-logo" src="<%= siteLogoUrl() %>" alt=""><% } else { %><span class="brand-mark" aria-hidden="true"></span><% } %><%= site.siteName %></a>
    <%
      // Marks the section the visitor is in. A competition's admin pages belong to Competitions.
      const current = (href) => {
        if (href === '/') return currentPath === '/' || currentPath.startsWith('/competitions');
        if (href === '/news') return currentPath === '/news' || currentPath.startsWith('/news/') || currentPath.startsWith('/admin/news');
        if (href === '/admin') return currentPath === '/admin';
        if (href === '/admin/competitions') return currentPath.startsWith('/admin/competitions') || currentPath.startsWith('/admin/fighters') || currentPath.startsWith('/competitions');
        if (href === '/official') return currentPath === '/official' || currentPath.startsWith('/admin/competitions') || currentPath.startsWith('/screens');
        return currentPath === href || currentPath.startsWith(`${href}/`);
      };
      const link = (href, label) => `<a href="${href}"${current(href) ? ' aria-current="page"' : ''}>${label}</a>`;
    %>
    <% if (!user) { %>
    <%# Visitors: the front page has competitions and news, so the bar only needs a way in. %>
    <% if (!['/login', '/register', '/login/code'].includes(currentPath)) { %><a class="btn small topbar-login" href="/login">Log in</a><% } %>
    <% } else { %>
    <%# On phones, public/app.js folds the menu behind this button. Without JavaScript the menu stays open. %>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" hidden>Menu</button>
    <nav class="nav" id="main-nav" aria-label="Main">
      <%# Each role's own pages first, then the pages everyone shares, then admin tools. %>
      <% if (user.role === 'admin') { %>
        <%- link('/admin', 'Dashboard') %>
      <% } else if (user.role === 'official') { %>
        <%- link('/official', 'Competition day') %>
      <% } else { %>
        <%- link('/home', 'Home') %>
        <%- user.club_id ? link('/club', 'Club dashboard') : link('/coach', 'Join a club') %>
      <% } %>
      <%# Admins manage competitions; everyone else sees the public list. %>
      <%- user.role === 'admin' ? link('/admin/competitions', 'Competitions') : link('/', 'Competitions') %>
      <%- link('/news', 'News') %>
      <% if (user.role === 'admin') { %>
        <%- link('/admin/clubs', 'Clubs and coaches') %>
        <%- link('/admin/accounts', 'Accounts') %>
        <%- link('/admin/activity', 'Activity log') %>
        <%- link('/admin/backups', 'Backups') %>
        <%- link('/admin/email', 'Email') %>
        <%- link('/admin/settings', 'Settings') %>
      <% } %>
        <a class="who" href="/account" title="My account"<%- currentPath.startsWith('/account') ? ' aria-current="page"' : '' %>><% if (user.club_id) { %><%- include('club_icon', { clubId: user.club_id, name: user.club_name, size: 'sm' }) %><% } %><%= user.full_name || user.email %><%= user.club_name ? ` · ${user.club_name}` : '' %></a>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="link-button" type="submit">Log out</button>
        </form>
    </nav>
    <% } %>
  </div>
</header>
<main>
<% flash.forEach((item) => { %>
  <div class="notice <%= item.type %>" role="status"><%= item.text %></div>
<% }) %>
