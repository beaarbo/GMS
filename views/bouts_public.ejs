<%- include('partials/top') %>
<p class="breadcrumb"><a href="/competitions/<%= competition.id %>"><%= competition.name %></a></p>
<div class="page-head">
  <div>
    <h1>Kyorugi bout list</h1>
    <p class="sub"><%= competition.name %> · <%= competition.venue %>, <%= eventDatesText(competition) %></p>
  </div>
  <div class="actions">
    <a class="btn" href="/competitions/<%= competition.id %>/bouts.pdf">Download PDF</a>
  </div>
</div>

<%- include('partials/medals') %>

<% divisions.forEach((division) => { %>
  <section class="card">
    <div class="division-head">
      <h2><%= division.title %></h2>
      <p class="stats">
        <span>Day: <strong><%= division.dayLabel %></strong></span>
        <span>Court: <strong><%= division.court || '–' %></strong></span>
        <span>Participants: <strong><%= division.participants %></strong></span>
        <span>Matches: <strong><%= division.matches %></strong></span>
      </p>
    </div>
    <%- include('partials/bracket', { division, highlightClubId }) %>
  </section>
<% }) %>
<%- include('partials/bottom') %>
