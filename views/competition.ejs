<%- include('partials/top') %>
<% const open = isRegistrationOpen(competition); %>
<div class="page-head">
  <div class="title-row">
    <%- include('partials/comp_logo', { competition, size: 'lg' }) %>
    <div>
      <h1><%= competition.name %></h1>
      <p class="sub"><%= EVENT_TYPES[competition.events] %> · <%= eventDatesText(competition) %> · <%= competition.venue %></p>
      <p class="sub">Registration deadline: <%= deadlineText(competition) %> · <%= open ? timeLeft(competition) : 'Closed' %></p>
    </div>
  </div>
  <% if (user && user.club_id) { %>
    <a class="btn" href="/club/competitions/<%= competition.id %>"><%= open ? 'Register athletes' : 'View your entries' %></a>
  <% } else if (user && user.role === 'coach') { %>
    <a class="btn" href="/coach">Join a club to enter</a>
  <% } else if (!user && open) { %>
    <a class="btn" href="/register">Create a coach account to enter</a>
  <% } %>
</div>

<% if (competition.bouts_published_at || poomsaePublished) { %>
  <section class="card">
    <h2>Bout lists and results</h2>
    <p class="sub">Who competes when, on which court, and who won.</p>
    <div class="actions">
      <% if (hasResults) { %><a class="btn approve" href="/competitions/<%= competition.id %>/results">Results and medals</a><% } %>
      <% if (competition.bouts_published_at) { %><a class="btn" href="/competitions/<%= competition.id %>/bouts">Kyorugi bout list</a><a class="btn secondary" href="/competitions/<%= competition.id %>/bouts.pdf">Kyorugi PDF</a><% } %>
      <% if (poomsaePublished) { %><a class="btn" href="/competitions/<%= competition.id %>/poomsae">Poomsae order and brackets</a><a class="btn secondary" href="/competitions/<%= competition.id %>/poomsae.pdf">Poomsae PDF</a><% } %>
    </div>
  </section>
<% } %>

<% if (user && user.role === 'admin') { %>
  <div class="actions page-actions">
    <a class="btn secondary small" href="/admin/competitions/<%= competition.id %>/edit">Edit details</a>
    <a class="btn secondary small" href="/admin/competitions/<%= competition.id %>/files">Logo and files</a>
  </div>
<% } %>

<% if (competition.description) { %>
  <section class="card">
    <h2>About this competition</h2>
    <%- include('partials/news_body', { text: competition.description }) %>
  </section>
<% } %>

<% if (competition.map_query) { %>
  <section class="card">
    <h2>Location</h2>
    <p class="sub"><%= competition.venue %></p>
    <%- include('partials/map', { query: competition.map_query, label: competition.venue }) %>
  </section>
<% } %>

<% if (files.length > 0) { %>
  <section class="card">
    <h2>Documents</h2>
    <ul class="file-list">
      <% files.forEach((file) => { %>
        <li>
          <a href="/competitions/<%= competition.id %>/files/<%= file.id %>"><%= file.title %></a>
          <span class="hint"><%= file.filename.split('.').pop().toUpperCase() %> · <%= fileSize(file.size) %></span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (hasPoomsae(competition)) { %>
  <section class="card">
    <h2>Poomsae divisions</h2>
    <p class="sub">Individual, pair (2 athletes) and team (3 athletes) events, divided by age group and then belt group, with boys and girls apart. Pairs and teams of boys and girls together compete as mixed, and are placed by their oldest athlete and highest belt.
      <% if (competition.poomsae_format === 'elimination') { %>Entries face each other in a single-elimination bracket.
      <% } else if (competition.poomsae_format === 'cut') { %>In divisions with more than <%= competition.poomsae_cut %> entries, everyone performs in a score round and the top <%= competition.poomsae_cut %> go into a single-elimination bracket, seeded by their score. Smaller divisions go straight to the bracket.
      <% } else { %>Entries are ranked by their judged score.<% } %>
      <%= competition.age_basis === 'year' ? 'Age is the competition year minus the birth year.' : 'Age is taken on the first day of the event.' %>
      <% if (competition.max_per_club_division) { %>Each club can enter at most <strong><%= competition.max_per_club_division %></strong> entr<%= competition.max_per_club_division === 1 ? 'y' : 'ies' %> per division.<% } %></p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Poomsae age group</th><th>Ages</th></tr></thead>
        <tbody>
          <% setup.poomsaeAgeGroups.forEach((g) => { %><tr><td><strong><%= g.name %></strong></td><td class="nowrap"><%= g.min_age %>–<%= g.max_age %></td></tr><% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>

<% if (hasKyorugi(competition)) { %>
<section class="card">
  <h2>Kyorugi divisions</h2>
  <p class="sub">Fighters are grouped by gender, age, belt and weight.
    <%= competition.age_basis === 'year' ? 'Age is the competition year minus the birth year.' : 'Age is taken on the first day of the event.' %>
    <% if (competition.max_per_club_division) { %>Each club can enter at most <strong><%= competition.max_per_club_division %></strong> athlete<%= competition.max_per_club_division === 1 ? '' : 's' %> per division.<% } %></p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Age group</th><th>Ages</th><th>Male weight classes</th><th>Female weight classes</th></tr></thead>
      <tbody>
        <% setup.ageGroups.forEach((g) => { const classes = (gender) => setup.weightClasses.filter((w) => w.age_group_id === g.id && w.gender === gender).map((w) => w.label).join(', '); %>
          <tr>
            <td><strong><%= g.name %></strong></td>
            <td class="nowrap"><%= g.min_age %>–<%= g.max_age %></td>
            <td><%= classes('M') %></td>
            <td><%= classes('F') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<% } %>

<section class="card">
  <h2>Belt groups</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Group</th><th>Belts</th></tr></thead>
      <tbody>
        <% setup.beltGroups.forEach((g) => { %>
          <tr>
            <td><strong><%= g.name %></strong></td>
            <td><%= BELTS.filter((b) => b.rank >= g.min_rank && b.rank <= g.max_rank).map((b) => b.name).join(', ') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/bottom') %>
