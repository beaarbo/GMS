<%- include('partials/top') %>
<% const open = isRegistrationOpen(competition); %>
<div class="page-head">
  <div class="title-row">
    <%- include('partials/comp_logo', { competition, size: 'lg' }) %>
    <div>
      <h1><%= competition.name %></h1>
      <p class="sub"><%= eventDatesText(competition) %> · <%= competition.venue %></p>
      <p class="sub">Registration deadline: <%= deadlineText(competition) %> · <%= open ? timeLeft(competition) : 'Closed' %></p>
    </div>
  </div>
  <% if (user && user.club_id) { %>
    <a class="btn" href="/club/competitions/<%= competition.id %>"><%= open ? 'Register athletes' : 'View your entries' %></a>
  <% } else if (user && user.role === 'coach') { %>
    <a class="btn" href="/coach">Join a club to enter</a>
  <% } else if (!user && open) { %>
    <a class="btn" href="/register">Create a coach account to enter</a>
  <% } %>
</div>

<% if (user && user.role === 'admin') { %>
  <div class="actions page-actions">
    <a class="btn secondary small" href="/admin/competitions/<%= competition.id %>/edit">Edit details</a>
    <a class="btn secondary small" href="/admin/competitions/<%= competition.id %>/files">Logo and files</a>
  </div>
<% } %>

<% if (competition.description) { %>
  <section class="card">
    <h2>About this competition</h2>
    <%- include('partials/news_body', { text: competition.description }) %>
  </section>
<% } %>

<% if (files.length > 0) { %>
  <section class="card">
    <h2>Documents</h2>
    <ul class="file-list">
      <% files.forEach((file) => { %>
        <li>
          <a href="/competitions/<%= competition.id %>/files/<%= file.id %>"><%= file.title %></a>
          <span class="hint"><%= file.filename.split('.').pop().toUpperCase() %> · <%= fileSize(file.size) %></span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<section class="card">
  <h2>Kyorugi divisions</h2>
  <p class="sub">Fighters are grouped by gender, age, belt and weight.
    <%= competition.age_basis === 'year' ? 'Age is the competition year minus the birth year.' : 'Age is taken on the first day of the event.' %></p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Age group</th><th>Ages</th><th>Male weight classes</th><th>Female weight classes</th></tr></thead>
      <tbody>
        <% setup.ageGroups.forEach((g) => { const classes = (gender) => setup.weightClasses.filter((w) => w.age_group_id === g.id && w.gender === gender).map((w) => w.label).join(', '); %>
          <tr>
            <td><strong><%= g.name %></strong></td>
            <td class="nowrap"><%= g.min_age %>–<%= g.max_age %></td>
            <td><%= classes('M') %></td>
            <td><%= classes('F') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="card">
  <h2>Belt groups</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Group</th><th>Belts</th></tr></thead>
      <tbody>
        <% setup.beltGroups.forEach((g) => { %>
          <tr>
            <td><strong><%= g.name %></strong></td>
            <td><%= BELTS.filter((b) => b.rank >= g.min_rank && b.rank <= g.max_rank).map((b) => b.name).join(', ') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/bottom') %>
