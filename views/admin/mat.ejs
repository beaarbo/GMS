<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Court <%= court %> results · <%= competition.name %></title>
  <script src="/theme.js"></script>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<%# Updates live when a result is recorded elsewhere, using the court screen's stream. %>
<body class="mat" data-live-events="/screens/<%= competition.id %>/<%= day %>/<%= court %>/events">
<% const back = (boutId) => `<input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="back" value="mat"><input type="hidden" name="day" value="${day}"><input type="hidden" name="court" value="${court}">`; %>
<header class="mat-head">
  <div>
    <h1>Court <%= court %></h1>
    <p class="sub"><%= competition.name %> · <%= dayLabel %></p>
  </div>
  <nav class="actions" aria-label="Court">
    <span class="screen-status" id="screen-status" hidden></span>
    <a class="btn secondary small" href="/admin/competitions/<%= competition.id %>/results?day=<%= day %>&court=<%= court %>">All bouts</a>
    <a class="btn secondary small" href="/screens/<%= competition.id %>/<%= day %>/<%= court %>">Court screen</a>
    <a class="btn secondary small" href="<%= user.role === 'admin' ? `/admin/competitions/${competition.id}/bouts` : '/official' %>"><%= user.role === 'admin' ? 'Bout list' : 'Competition day' %></a>
  </nav>
</header>

<main class="mat-main" data-live-part="main">
  <% flash.forEach((item) => { %>
    <div class="notice <%= item.type %>" role="status"><%= item.text %></div>
  <% }) %>
  <p class="mat-progress"><%= done %> of <%= total %> bouts done</p>

  <section class="card mat-now">
    <% if (now) { %>
      <h2>Bout <%= now.number %> <span class="hint">· <%= now.time %> · <%= now.title %></span></h2>
      <p class="sub">Tap the winner. They move into their next bout.</p>
      <form method="post" action="/admin/competitions/<%= competition.id %>/results/<%= now.id %>" class="mat-choices">
        <%- back(now.id) %>
        <div class="win-details">
          <label>How <select name="win_type" aria-label="How bout <%= now.number %> was won"><option value="">Not recorded</option><% Object.entries(WIN_TYPES).forEach(([code, label]) => { %><option value="<%= code %>"><%= code %>: <%= label %></option><% }) %></select></label>
          <label>Score <input name="score" inputmode="numeric" autocomplete="off" placeholder="2-1" maxlength="7" aria-label="Score of bout <%= now.number %>"></label>
          <span class="hint">Optional. Choose these first, then tap the winner.</span>
        </div>
        <button class="mat-winner blue" type="submit" name="winner" value="blue" aria-label="<%= now.blue.name %> wins bout <%= now.number %>">
          <span class="mat-corner">Blue wins</span>
          <strong><%= now.blue.name %></strong>
          <span><%= now.blue.club %></span>
        </button>
        <button class="mat-winner red" type="submit" name="winner" value="red" aria-label="<%= now.red.name %> wins bout <%= now.number %>">
          <span class="mat-corner">Red wins</span>
          <strong><%= now.red.name %></strong>
          <span><%= now.red.club %></span>
        </button>
      </form>
    <% } else if (blockedBy) { %>
      <h2>Waiting</h2>
      <p class="empty">Bout <%= blockedBy.number %> is waiting for an earlier result, probably on another court. This page updates when it's ready.</p>
    <% } else { %>
      <h2>All done</h2>
      <p class="empty">Every bout on this court is finished.</p>
    <% } %>
  </section>

  <div class="overview-grid">
    <section class="card">
      <h2>Up next</h2>
      <% if (next.length === 0) { %><p class="empty">Nothing else on this court.</p><% } %>
      <ol class="overview-list">
        <% next.forEach((b) => { %>
          <li><strong>Bout <%= b.number %></strong> · <%= b.time %><br><span class="blue-text-dark"><%= b.blue ? b.blue.name : b.bluePlaceholder %></span> vs <span class="red-text-dark"><%= b.red ? b.red.name : b.redPlaceholder %></span><div class="hint"><%= b.title %></div></li>
        <% }) %>
      </ol>
    </section>
    <section class="card">
      <h2>Last result</h2>
      <% if (!last) { %>
        <p class="empty">No results yet.</p>
      <% } else { %>
        <p><strong><%= last.winner.name %></strong> won bout <%= last.number %><%= last.walkover ? ' by walkover' : '' %><% if (last.winType || last.score) { %> (<%= [last.winType, last.score].filter(Boolean).join(' ') %>)<% } %><br><span class="hint"><%= last.title %></span></p>
        <% if (last.walkover) { %>
          <p class="hint">Their opponent was out at the weigh-in. Undo that weigh-in to change it.</p>
        <% } else { %>
          <form method="post" action="/admin/competitions/<%= competition.id %>/results/<%= last.id %>" data-confirm="Undo the result of bout <%= last.number %>?">
            <%- back(last.id) %>
            <input type="hidden" name="action" value="clear">
            <button class="btn danger" type="submit">Undo this result</button>
          </form>
          <p class="hint">It can only be undone while the next bout has no result.</p>
        <% } %>
      <% } %>
    </section>
  </div>
</main>
</body>
</html>
