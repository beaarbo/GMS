<%- include('../partials/top') %>
<p class="breadcrumb"><a href="/admin">Admin dashboard</a></p>
<div class="page-head">
  <div>
    <h1>Competitions</h1>
    <p class="sub">Create competitions, open and close registration, and run each one. <a href="/">See the public competitions page</a></p>
  </div>
  <a class="btn" href="/admin/competitions/new">New competition</a>
</div>

<% if (competitions.length === 0) { %>
  <div class="card"><p class="empty">No competitions yet. Create your first one to get started.</p></div>
<% } %>

<% competitions.forEach((c) => { %>
  <section class="card" id="competition-<%= c.id %>">
    <div class="page-head">
      <div class="title-row">
        <%- include('../partials/comp_logo', { competition: c, size: 'md' }) %>
        <div>
          <h2><%= c.name %> <span class="badge <%= c.status %>"><%= statusLabel(c.status) %></span></h2>
          <p class="sub"><%= EVENT_TYPES[c.events] %> · <%= eventDatesText(c) %> · <%= c.venue %> · Registration deadline: <%= deadlineText(c) %><% if (isRegistrationOpen(c)) { %> (<%= timeLeft(c) %>)<% } %></p>
        </div>
      </div>
    </div>
    <% const missing = [!competitionLogoUrl(c.id) && 'a logo', !String(c.description || '').trim() && 'a description'].filter(Boolean); %>
    <% if (missing.length > 0) { %>
      <div class="notice info">Needs <%= missing.join(' and ') %> before it can open for registration.</div>
    <% } %>
    <% if (hasKyorugi(c)) { %>
      <p class="stats">
        <% if (hasPoomsae(c)) { %><span>Kyorugi:</span><% } %>
        <span><strong><%= c.pending || 0 %></strong> pending</span>
        <span><strong><%= c.approved || 0 %></strong> approved</span>
        <span><strong><%= c.rejected || 0 %></strong> rejected</span>
      </p>
    <% } %>
    <% if (hasPoomsae(c)) { %>
      <p class="stats">
        <% if (hasKyorugi(c)) { %><span>Poomsae:</span><% } %>
        <span><strong><%= c.poomsae_pending %></strong> pending</span>
        <span><strong><%= c.poomsae_approved %></strong> approved</span>
      </p>
    <% } %>
    <div class="actions">
      <%# Review registrations and Bout list cover kyorugi and poomsae together. %>
      <a class="btn small" href="/admin/competitions/<%= c.id %>/registrations">Review registrations</a>
      <% if (c.status === 'closed') { %><a class="btn small" href="/admin/competitions/<%= c.id %>/bouts">Bout list</a><a class="btn small" href="/admin/competitions/<%= c.id %>/results">Results</a><% } %>
      <a class="btn secondary small" href="/admin/competitions/<%= c.id %>/divisions">Divisions</a>
      <% if ((c.approved || 0) + (c.poomsae_approved || 0) > 0) { %><a class="btn secondary small" href="/admin/competitions/<%= c.id %>/cards.pdf">Athlete cards</a><% } %>
      <% if (hasKyorugi(c) && c.status === 'closed') { %><a class="btn secondary small" href="/admin/competitions/<%= c.id %>/weigh-in">Weigh-in</a><% } %>
      <a class="btn secondary small" href="/admin/competitions/<%= c.id %>/setup">Division setup</a>
      <a class="btn secondary small" href="/admin/competitions/<%= c.id %>/edit">Edit</a>
      <a class="btn secondary small" href="/admin/competitions/<%= c.id %>/files">Logo and files</a>
      <form method="post" action="/admin/competitions/<%= c.id %>/status">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (c.status === 'open') { %>
          <button class="btn secondary small" name="status" value="closed" type="submit">Close registration</button>
        <% } else { %>
          <button class="btn approve small" name="status" value="open" type="submit"><%= c.status === 'draft' ? 'Publish' : 'Reopen registration' %></button>
        <% } %>
      </form>
      <% const entries = (c.pending || 0) + (c.approved || 0) + (c.rejected || 0) + c.poomsae_count; %>
      <% if (c.status === 'draft' && entries === 0) { %>
        <form method="post" action="/admin/competitions/<%= c.id %>/delete" data-confirm="Delete this draft competition? This cannot be undone.">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn danger small" type="submit">Delete</button>
        </form>
      <% } else if (c.status !== 'open') { %>
        <a class="btn danger small" href="/admin/competitions/<%= c.id %>/delete">Delete</a>
      <% } %>
    </div>
  </section>
<% }) %>

<%# The demo competition: the main admin's to make and remove. %>
<% if (user.owner) { %>
  <section class="card" id="demo">
    <h2>Demo competition</h2>
    <% if (demo) { %>
      <p class="sub">The demo competition, its three clubs, their coaches and athletes are on the site. Remove them when you've finished showing the site; nothing else is touched.</p>
      <form method="post" action="/admin/demo/remove" data-confirm="Remove the demo competition with its clubs, coaches and athletes? This cannot be undone.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn danger" type="submit">Remove demo data</button>
      </form>
    <% } else { %>
      <p class="sub">Makes a ready-to-show competition with made-up clubs and athletes: three clubs with a coach each, about thirty athletes, and kyorugi and poomsae drawn on two courts and published, with no results yet, so you can record results, call bouts and show the screens live. It's public like any published competition.</p>
      <form method="post" action="/admin/demo" data-confirm="Create the demo competition? It will be public on the site until you remove it.">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn secondary" type="submit">Create demo competition</button>
      </form>
    <% } %>
  </section>
<% } %>
<%- include('../partials/bottom') %>
