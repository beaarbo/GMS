<%- include('../partials/top') %>
<div class="page-head">
  <div>
    <h1>Admin dashboard</h1>
    <p class="sub">An overview of the whole site. Competitions are managed on <a href="/admin/competitions">Competitions</a>.</p>
  </div>
</div>

<section class="card">
  <h2>Needs attention</h2>
  <% if (attention.length === 0) { %>
    <p class="empty">Nothing needs you right now.</p>
  <% } else { %>
    <ul class="attention-list">
      <% attention.forEach((item) => { %>
        <li class="attention-item <%= item.level %>">
          <span><%= item.text %></span>
          <a class="btn secondary small" href="<%= item.href %>"><%= item.link %></a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<section class="section">
  <div class="stat-grid">
    <a class="stat-tile" href="/admin/competitions">
      <span class="stat-label">Competitions</span>
      <strong class="stat-value"><%= totals.open + totals.closed + totals.draft %></strong>
      <span class="stat-detail"><%= totals.open %> open · <%= totals.closed %> closed · <%= totals.draft %> draft</span>
    </a>
    <a class="stat-tile" href="/admin/clubs">
      <span class="stat-label">Clubs</span>
      <strong class="stat-value"><%= totals.clubs %></strong>
      <span class="stat-detail"><%= totals.coaches %> approved coach<%= totals.coaches === 1 ? '' : 'es' %></span>
    </a>
    <div class="stat-tile">
      <span class="stat-label">Athletes</span>
      <strong class="stat-value"><%= totals.athletes %></strong>
      <span class="stat-detail">Across all clubs</span>
    </div>
    <a class="stat-tile" href="/admin/accounts?type=official">
      <span class="stat-label">Officials</span>
      <strong class="stat-value"><%= totals.officials %></strong>
      <span class="stat-detail">For weigh-in and results</span>
    </a>
    <a class="stat-tile" href="/admin/news">
      <span class="stat-label">News posts</span>
      <strong class="stat-value"><%= totals.news %></strong>
      <span class="stat-detail">On the News page</span>
    </a>
  </div>
</section>

<div class="overview-grid">
  <section class="card">
    <div class="section-head">
      <h2>Coming up</h2>
      <a href="/admin/competitions">All competitions</a>
    </div>
    <% if (upcoming.length === 0) { %>
      <p class="empty">No competitions coming up. <a href="/admin/competitions/new">Create one</a> on the Competitions page.</p>
    <% } else { %>
      <ul class="overview-list">
        <% upcoming.forEach((c) => { %>
          <li>
            <div class="title-row">
              <%- include('../partials/comp_logo', { competition: c, size: 'md' }) %>
              <div>
                <a class="title-link" href="/admin/competitions#competition-<%= c.id %>"><strong><%= c.name %></strong></a>
                <span class="badge <%= c.status %>"><%= statusLabel(c.status) %></span>
                <div class="hint"><%= eventDatesText(c) %> · <%= c.approved || 0 %> approved, <%= c.pending || 0 %> pending<%= isRegistrationOpen(c) ? ` · ${timeLeft(c)}` : '' %></div>
              </div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <div class="section-head">
      <h2>Recent activity</h2>
      <a href="/admin/activity">Activity log</a>
    </div>
    <% if (activity.length === 0) { %>
      <p class="empty">Nothing has happened yet.</p>
    <% } else { %>
      <ul class="overview-list">
        <% activity.forEach((a) => { %>
          <li><span><%= a.summary %></span><div class="hint"><%= a.actor %> · <%= formatActivityTime(a.at) %></div></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <div class="section-head">
      <h2>Latest news</h2>
      <a href="/admin/news">Manage news</a>
    </div>
    <% if (news.length === 0) { %>
      <p class="empty">No news posted yet.</p>
    <% } else { %>
      <ul class="overview-list">
        <% news.forEach((post) => { %>
          <li><a class="title-link" href="/news/<%= post.id %>"><strong><%= post.title %></strong></a><div class="hint"><%= postDate(post.created_at) %><%= post.audience === 'members' ? ' · Coaches and organisers' : '' %><%= post.pinned ? ' · Pinned' : '' %></div></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
<%- include('../partials/bottom') %>
