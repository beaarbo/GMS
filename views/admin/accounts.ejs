<%- include('../partials/top') %>
<p class="breadcrumb"><a href="/admin">Admin dashboard</a></p>
<div class="page-head">
  <div>
    <h1>Accounts</h1>
    <p class="sub"><%= total %> account<%= total === 1 ? '' : 's' %> in total. Coach approvals are on <a href="/admin/clubs">Clubs and coaches</a>.</p>
  </div>
</div>

<section class="card">
  <p class="stats">
    <a href="/admin/accounts<%= search ? `?q=${encodeURIComponent(search)}` : '' %>" class="<%= type ? '' : 'current-filter' %>">All</a>
    <% Object.entries(types).forEach(([key, t]) => { %>
      <a href="/admin/accounts?type=<%= key %><%= search ? `&q=${encodeURIComponent(search)}` : '' %>" class="<%= type === key ? 'current-filter' : '' %>"><%= t.label %> (<%= counts[key] %>)</a>
    <% }) %>
  </p>
  <form method="get" class="filters">
    <div>
      <label for="f-type">Type</label>
      <select id="f-type" name="type">
        <option value="">All</option>
        <% Object.entries(types).forEach(([key, t]) => { %><option value="<%= key %>" <%= type === key ? 'selected' : '' %>><%= t.label %></option><% }) %>
      </select>
    </div>
    <div>
      <label for="f-q">Name or email</label>
      <input id="f-q" name="q" value="<%= search %>">
    </div>
    <div class="actions">
      <button class="btn secondary" type="submit">Filter</button>
      <a href="/admin/accounts">Clear</a>
    </div>
  </form>
</section>

<% if (user.owner) { %>
  <section class="card">
    <h2>Add an admin</h2>
    <p class="sub">Admins can do everything you can, except add or remove admins, download backups and change the security settings. A one-time password is emailed to them, and they must choose their own when they first log in.</p>
    <form method="post" action="/admin/accounts/admins">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="form-row">
        <div class="field">
          <label for="a-name">Name</label>
          <input id="a-name" name="full_name" maxlength="100" required>
        </div>
        <div class="field">
          <label for="a-email">Email</label>
          <input id="a-email" name="email" type="email" required>
        </div>
      </div>
      <button class="btn" type="submit">Add admin and email their password</button>
    </form>
  </section>
<% } %>

<section class="card">
  <h2>Add a coach</h2>
  <p class="sub"><%= site.coachSignup ? 'Coaches can also sign up themselves and apply to a club.' : 'Coach sign-up is off on the Settings page, so coaches are added here.' %> Choosing a club approves them for it straight away.</p>
  <form method="post" action="/admin/accounts/coaches">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-row">
      <div class="field">
        <label for="c-name">Name</label>
        <input id="c-name" name="full_name" maxlength="100" required>
      </div>
      <div class="field">
        <label for="c-phone">Contact number</label>
        <input id="c-phone" name="phone" maxlength="40" required>
      </div>
      <div class="field">
        <label for="c-email">Email</label>
        <input id="c-email" name="email" type="email" required>
      </div>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="c-club">Club</label>
        <select id="c-club" name="club_id">
          <option value="">None yet (they apply themselves)</option>
          <% clubs.forEach((club) => { %><option value="<%= club.id %>"><%= club.name %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="c-password">Starting password</label>
        <input id="c-password" name="password" type="password" minlength="10" maxlength="72" autocomplete="new-password" required>
      </div>
    </div>
    <p class="hint">Give them the password privately. They can change it on My account.</p>
    <button class="btn" type="submit">Add coach</button>
  </form>
</section>

<section class="card">
  <h2>Add an official</h2>
  <p class="sub">Officials run the weigh-in, record results and use the court screens. They can't approve entries, draw bout lists or change settings.</p>
  <form method="post" action="/admin/accounts/officials">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="form-row">
      <div class="field">
        <label for="o-name">Name</label>
        <input id="o-name" name="full_name" maxlength="100" required>
      </div>
      <div class="field">
        <label for="o-email">Email</label>
        <input id="o-email" name="email" type="email" required>
      </div>
      <div class="field">
        <label for="o-password">Starting password</label>
        <input id="o-password" name="password" type="password" minlength="10" maxlength="72" autocomplete="new-password" required>
      </div>
    </div>
    <p class="hint">Give them the password privately. They can change it on My account.</p>
    <button class="btn" type="submit">Add official</button>
  </form>
</section>

<section class="card">
  <% if (accounts.length === 0) { %>
    <p class="empty">No accounts match.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Type</th><th>Club</th><th>Two-step login</th><th>Created</th></tr></thead>
        <tbody>
          <% accounts.forEach((a) => { %>
            <tr>
              <td><strong><%= a.full_name || '–' %></strong></td>
              <td><%= a.email %></td>
              <td class="nowrap"><%= a.phone || '–' %></td>
              <td>
                <% if (a.type === 'admin') { %><span class="badge open"><%= a.owner ? 'Main admin' : 'Admin' %></span>
                  <% if (a.must_change_password) { %><span class="badge pending">Hasn't logged in yet</span><% } %>
                  <% if (user.owner && !a.owner) { %>
                    <form class="inline-form" method="post" action="/admin/accounts/admins/<%= a.id %>/remove" data-confirm="Remove <%= a.full_name || a.email %> as an admin? Their account is deleted and they're logged out.">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn danger small" type="submit">Remove</button>
                    </form>
                  <% } %>
                <% } else if (a.type === 'official') { %><span class="badge open">Official</span>
                  <form class="inline-form" method="post" action="/admin/accounts/officials/<%= a.id %>/remove" data-confirm="Remove <%= a.full_name %>'s official account? They'll be logged out.">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <button class="btn danger small" type="submit">Remove</button>
                  </form>
                <% } else if (a.type === 'coach') { %><span class="badge approved">Coach</span>
                <% } else if (a.type === 'pending') { %><span class="badge pending">Awaiting approval</span>
                <% } else { %><span class="badge draft">No club</span><% } %>
                <% if (a.role === 'coach') { %>
                  <form class="inline-form" method="post" action="/admin/accounts/coaches/<%= a.id %>/delete" data-confirm="Delete <%= a.full_name || a.email %>'s account? This cannot be undone.<%= a.club ? ` ${a.club} keeps its athletes and entries.` : '' %>">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input type="hidden" name="type" value="<%= type %>">
                    <button class="btn danger small" type="submit">Delete</button>
                  </form>
                <% } %>
              </td>
              <td><%= a.club || (a.pending_club ? `Applied to ${a.pending_club}` : '–') %></td>
              <td class="nowrap">
                <% if (a.two_step) { %>On
                  <% if (a.id !== user.id && !a.owner) { %>
                    <form class="inline-form" method="post" action="/admin/accounts/<%= a.id %>/two-step/off" data-confirm="Turn off two-step login for <%= a.full_name || a.email %>? Do this only once you're sure it's them, for example if they lost their phone.">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <input type="hidden" name="type" value="<%= type %>">
                      <button class="btn secondary small" type="submit">Turn off</button>
                    </form>
                  <% } %>
                <% } else { %>Off<% } %>
              </td>
              <td class="nowrap"><%= formatActivityTime(a.created_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('../partials/bottom') %>
