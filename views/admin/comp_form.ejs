<%- include('../partials/top') %>
<p class="breadcrumb"><a href="/admin/competitions">Competitions</a></p>
<div class="card medium">
  <h1><%= title %></h1>
  <%- include('../partials/errors') %>
  <% if (locked) { %><div class="notice info">Clubs have registered, so the events, first event day and age rule are locked. You can still add or remove later days.</div><% } %>
  <% const creating = action === '/admin/competitions'; %>
  <form method="post" action="<%= action %>"<%- creating ? ' enctype="multipart/form-data"' : '' %>>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <label for="name">Competition name</label>
      <input id="name" name="name" value="<%= competition.name || '' %>" required>
    </div>
    <div class="field">
      <label for="venue">Venue</label>
      <input id="venue" name="venue" value="<%= competition.venue || '' %>" required>
    </div>
    <div class="field">
      <label for="map_query">Map location <span class="hint">(optional)</span></label>
      <input id="map_query" name="map_query" maxlength="300" value="<%= competition.map_query || '' %>" placeholder="For example: OCBC Arena, 5 Stadium Drive, Singapore">
      <p class="hint">Type the address or place name as you would in Google Maps, or paste a full Google Maps link (open the place in Google Maps on a computer and copy the address bar). The competition page shows it on a small map.</p>
      <% if (competition.map_query) { %><%- include('../partials/map', { query: competition.map_query, label: competition.venue }) %><% } %>
    </div>
    <div class="field">
      <label for="events">Events</label>
      <select id="events" name="events" <%= locked ? 'disabled' : '' %>>
        <% Object.entries(EVENT_TYPES).forEach(([value, label]) => { %><option value="<%= value %>" <%= (competition.events || 'kyorugi') === value ? 'selected' : '' %>><%= label %></option><% }) %>
      </select>
      <p class="hint">Poomsae has individual, pair and team events. Fixed once clubs have entered.</p>
    </div>
    <div class="form-row">
      <div class="field">
        <label for="poomsae_format">Poomsae format</label>
        <select id="poomsae_format" name="poomsae_format" <%= locals.formatLocked ? 'disabled' : '' %>>
          <% Object.entries(POOMSAE_FORMATS).forEach(([value, label]) => { %><option value="<%= value %>" <%= (competition.poomsae_format || 'score') === value ? 'selected' : '' %>><%= label %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="poomsae_cut">Top entries into the bracket</label>
        <input id="poomsae_cut" name="poomsae_cut" type="number" min="2" max="<%= MAX_CUT %>" step="1" inputmode="numeric" value="<%= competition.poomsae_cut ?? 16 %>" <%= locals.formatLocked ? 'disabled' : '' %>>
      </div>
    </div>
    <p class="hint">Only for poomsae. <strong>Ranked by score</strong>: the highest scores win the medals. <strong>Single elimination</strong>: entries face each other in a bracket, drawn at random with clubs kept apart. <strong>Score round, then single elimination</strong>: a division with more entries than the number above is scored first, and the top ones go into a bracket seeded by their rank; smaller divisions go straight to the bracket. <%= locals.formatLocked ? 'Fixed now that poomsae has scores or brackets.' : '' %></p>
    <fieldset class="date-list">
      <legend>Event dates</legend>
      <p class="hint">Enter each competition day. They don't need to be in a row, so two weekends works. To add more than these boxes allow, save and more appear. Ages use the first day.</p>
      <% const dates = competition.event_dates || []; %>
      <% const boxes = Math.max(dates.length + 2, 4); %>
      <div class="form-row">
        <% for (let i = 0; i < boxes; i += 1) { %>
          <div class="field">
            <label for="event_date_<%= i %>">Day <%= i + 1 %></label>
            <input id="event_date_<%= i %>" name="event_dates" type="date" value="<%= dates[i] || '' %>" <%= locked && i === 0 ? 'disabled' : '' %> <%= !locked && i === 0 ? 'required' : '' %>>
          </div>
        <% } %>
      </div>
    </fieldset>
    <div class="form-row">
      <div class="field">
        <label for="registration_deadline">Registration deadline</label>
        <input id="registration_deadline" name="registration_deadline" type="date" value="<%= competition.registration_deadline || '' %>" required>
      </div>
      <div class="field">
        <label for="registration_deadline_time">Closes at</label>
        <input id="registration_deadline_time" name="registration_deadline_time" type="time" value="<%= competition.registration_deadline_time || '23:59' %>" required>
      </div>
    </div>
    <p class="hint">Registration closes by itself at this time. To reopen it, set a later deadline.</p>
    <div class="field">
      <label for="age_basis">How age is calculated</label>
      <select id="age_basis" name="age_basis" <%= locked ? 'disabled' : '' %>>
        <option value="year" <%= competition.age_basis === 'year' ? 'selected' : '' %>>Competition year minus birth year</option>
        <option value="date" <%= competition.age_basis === 'date' ? 'selected' : '' %>>Exact age on the first event day</option>
      </select>
    </div>
    <div class="field">
      <label for="max_per_club_division">Most athletes from one club per division <span class="hint">(optional)</span></label>
      <input id="max_per_club_division" name="max_per_club_division" type="number" min="1" max="50" step="1" inputmode="numeric" value="<%= competition.max_per_club_division ?? '' %>" placeholder="No limit">
      <p class="hint">For example 2: a club can enter at most two athletes in each division (each gender, age, belt and weight). Leave blank for no limit. Lowering it later keeps entries already made.</p>
    </div>
    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="8" maxlength="5000" required><%= competition.description || '' %></textarea>
      <p class="hint">Shown on the competition page. Plain text: leave a blank line between paragraphs, and web addresses become links.</p>
    </div>
    <% if (creating) { %>
      <div class="field">
        <label for="logo">Logo <span class="hint">(needed before you publish)</span></label>
        <input id="logo" name="logo" type="file" accept="image/jpeg,image/png,image/webp">
        <p class="hint">JPG, PNG or WebP, up to 1 MB. A square picture works best.</p>
      </div>
      <div class="field">
        <label for="files">Files for clubs <span class="hint">(optional)</span></label>
        <input id="files" name="files" type="file" accept=".pdf,.docx,.xlsx,.jpg,.jpeg,.png,.webp" multiple>
        <p class="hint">Choose up to <%= maxNewFiles %> at once, such as the prospectus, rules or forms: PDF, Word (.docx), Excel (.xlsx), JPG, PNG or WebP, up to 10 MB each. Each is titled with its file name. You can add more, or retitle one by attaching it again, later from Logo and files.</p>
      </div>
      <div class="field">
        <label for="photos">Photos <span class="hint">(optional)</span></label>
        <input id="photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple data-photo-preview="photos-preview" data-room="<%= maxPhotos %>">
        <p class="hint">Up to <%= maxPhotos %> pictures for the competition page: JPG, PNG or WebP, up to 5 MB each. Anyone who can see the competition can see them.</p>
        <div class="photo-grid photo-preview" id="photos-preview" aria-live="polite" hidden></div>
      </div>
    <% } else { %>
      <p class="hint">To change the logo, photos or attached files, use <a href="/admin/competitions/<%= competition.id %>/files">Logo and files</a>.</p>
    <% } %>
    <div class="actions">
      <button class="btn" type="submit">Save</button>
      <a class="btn secondary" href="/admin/competitions">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/bottom') %>
