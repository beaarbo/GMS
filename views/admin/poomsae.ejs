<%- include('../partials/top') %>
<% const isAdmin = user.role === 'admin'; %>
<p class="breadcrumb"><% if (isAdmin) { %><a href="/admin/competitions">Competitions</a><% } else { %><a href="/official">Competition day</a><% } %></p>
<div class="page-head">
  <div>
    <h1>Poomsae</h1>
    <p class="sub"><%= competition.name %> · <%= pending %> pending · <%= approved %> approved · <%= scored %> of <%= approved %> scored</p>
  </div>
  <% if (isAdmin && pending > 0) { %>
    <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/review" data-confirm="Approve all <%= pending %> pending entries?">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn approve" name="bulk" value="approve-pending" type="submit">Approve all pending</button>
    </form>
  <% } %>
</div>

<% if (!canScore) { %>
  <div class="notice info">Scores can be entered once registration closes. Until then, review the entries here.</div>
<% } else { %>
  <p class="sub">Enter each entry's final score, the judges' average, such as 7.85. Places update as you go; equal scores share a place. Clear a score to undo it.</p>
<% } %>

<% if (divisions.length === 0) { %>
  <section class="card"><p class="empty">No poomsae entries yet.</p></section>
<% } %>

<% divisions.forEach((d) => { %>
  <section class="card">
    <h2><%= d.title %></h2>
    <p class="sub"><%= d.approved %> approved<% if (canScore) { %> · <%= d.scored %> scored<% } %></p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Place</th><th>Athletes</th><th>Club</th><th>Score</th><% if (isAdmin) { %><th>Review</th><% } %></tr></thead>
        <tbody>
          <% d.entries.forEach((e) => { %>
            <tr id="entry-<%= e.id %>">
              <td class="nowrap"><% if (e.place) { %><strong><%= placeText(e.place) %></strong><% } else if (e.status === 'pending') { %><span class="badge pending">Pending</span><% } %></td>
              <td><strong><%= e.names %></strong><% if (e.event !== 'individual') { %><div class="hint"><%= e.athletes.map((a) => `${beltName(a.belt_rank)}, ${a.age_at_event}`).join(' · ') %></div><% } else { %><div class="hint"><%= beltName(e.athletes[0].belt_rank) %>, age <%= e.athletes[0].age_at_event %></div><% } %></td>
              <td><%= e.club_name %></td>
              <td class="nowrap">
                <% if (canScore && e.status === 'approved') { %>
                  <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/<%= e.id %>/score" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrf %>">
                    <input class="score-input" name="score" inputmode="decimal" autocomplete="off" value="<%= e.score === null ? '' : formatScore(e.score) %>" aria-label="Score of <%= e.names %>">
                    <button class="btn secondary small" type="submit">Save</button>
                  </form>
                <% } else if (e.score !== null) { %><%= formatScore(e.score) %><% } %>
              </td>
              <% if (isAdmin) { %>
                <td>
                  <% if (e.score === null) { %>
                    <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/review" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <% if (e.status === 'pending') { %><button class="btn approve small" name="single" value="approved:<%= e.id %>" type="submit">Approve</button><% } %>
                      <input class="note-input" name="note_<%= e.id %>" maxlength="300" placeholder="Reason to reject" aria-label="Reason to reject <%= e.names %>">
                      <button class="btn danger small" name="single" value="rejected:<%= e.id %>" type="submit">Reject</button>
                    </form>
                  <% } else { %><span class="hint">Scored</span><% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% }) %>

<% if (isAdmin && rejected.length > 0) { %>
  <section class="card">
    <h2>Rejected</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Athletes</th><th>Division</th><th>Club</th><th>Reason</th><th></th></tr></thead>
        <tbody>
          <% rejected.forEach((e) => { %>
            <tr id="entry-<%= e.id %>">
              <td><strong><%= e.names %></strong></td>
              <td><%= poomsaeDivisionTitle(e) %></td>
              <td><%= e.club_name %></td>
              <td><%= e.review_note %></td>
              <td>
                <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/review">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn secondary small" name="single" value="pending:<%= e.id %>" type="submit">Move back to pending</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
<%- include('../partials/bottom') %>
