<%- include('../partials/top') %>
<% const isAdmin = user.role === 'admin'; %>
<p class="breadcrumb"><% if (isAdmin) { %><a href="/admin/competitions">Competitions</a><% } else { %><a href="/official">Competition day</a><% } %></p>
<div class="page-head">
  <div>
    <h1>Poomsae</h1>
    <p class="sub"><%= competition.name %> · <%= POOMSAE_FORMATS[competition.poomsae_format] %><%= competition.poomsae_format === 'cut' ? ` (top ${competition.poomsae_cut})` : '' %> · <%= pending %> pending · <%= approved %> approved</p>
  </div>
  <div class="actions">
    <% if (isAdmin && pending > 0) { %>
      <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/review" data-confirm="Approve all <%= pending %> pending entries?">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn approve" name="bulk" value="approve-pending" type="submit">Approve all pending</button>
      </form>
    <% } %>
    <% if (isAdmin && closed && orderable > 0) { %>
      <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/order">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn" name="division" value="all" type="submit">Make <%= orderable %> performance list<%= orderable === 1 ? '' : 's' %></button>
      </form>
    <% } %>
    <% if (hasPages) { %><a class="btn secondary" href="/admin/competitions/<%= competition.id %>/poomsae.pdf">Download PDF</a><% } %>
    <% if (isAdmin) { %>
      <% [['lists', 'performance order', hasLists, competition.poomsae_published_at], ['brackets', 'brackets', hasBrackets, competition.poomsae_brackets_published_at]].forEach(([stage, label, ready, published]) => { %>
        <% if (ready || published) { %>
          <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/<%= published ? 'unpublish' : 'publish' %>">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn <%= published ? 'secondary' : 'approve' %>" name="stage" value="<%= stage %>" type="submit"><%= published ? `Hide ${label}` : `Publish ${label}` %></button>
          </form>
        <% } %>
      <% }) %>
    <% } %>
    <% if (competition.poomsae_published_at || competition.poomsae_brackets_published_at) { %><a class="btn secondary" href="/competitions/<%= competition.id %>/poomsae">Public page</a><% } %>
    <% if (isAdmin && closed && drawable > 0) { %>
      <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/draw">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn" name="division" value="all" type="submit">Draw <%= drawable %> ready bracket<%= drawable === 1 ? '' : 's' %></button>
      </form>
    <% } %>
  </div>
</div>

<% if (!closed) { %>
  <div class="notice info">Scores and brackets open once registration closes. Until then, review the entries here.</div>
<% } else if (competition.poomsae_format !== 'elimination') { %>
  <p class="sub">Enter each final score, the judges' average, such as 7.85. Equal scores share a place. Clear a score to undo it.</p>
<% } %>

<% if (isAdmin) { %>
  <section class="card">
    <h2>Poomsae schedule</h2>
    <p class="sub">Brackets run on their own courts, called Poomsae court 1 and up. Each bracket is timed when it's drawn, after the brackets already on the court that's free soonest, so times already given out stay put. Saving here times every bracket again.</p>
    <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/schedule" class="filters">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label for="p-courts">Courts</label><input id="p-courts" name="courts" type="number" min="1" max="20" value="<%= competition.poomsae_courts %>" required></div>
      <div><label for="p-start">Start time</label><input id="p-start" name="start" type="time" value="<%= competition.poomsae_start %>" required></div>
      <div><label for="p-minutes">Minutes per bout</label><input id="p-minutes" name="minutes" type="number" min="1" max="60" value="<%= competition.poomsae_minutes %>" required></div>
      <div><label for="p-rest">Rest between bouts (min)</label><input id="p-rest" name="rest" type="number" min="0" max="120" value="<%= competition.poomsae_rest_minutes %>" required></div>
      <div class="actions"><button class="btn secondary" type="submit">Save schedule</button></div>
    </form>
  </section>
<% } %>

<% if (divisions.length === 0) { %>
  <section class="card"><p class="empty">No poomsae entries yet.</p></section>
<% } %>

<% divisions.forEach((d) => { %>
  <% const scoring = closed && (d.mode === 'score' || (d.mode === 'cut' && !d.bouts)); %>
  <% const showScores = d.mode !== 'bracket'; %>
  <% const names = new Map(d.entries.map((e) => [e.id, e.names])); %>
  <section class="card" id="division-<%= d.key %>">
    <h2><%= d.title %></h2>
    <p class="sub">
      <%= d.approved %> approved<% if (d.pending) { %> · <%= d.pending %> pending<% } %> ·
      <% if (d.mode === 'score') { %>ranked by score
      <% } else if (d.mode === 'cut') { %>score round: the top <%= d.cut %> go into the bracket
      <% } else { %>single elimination<% } %>
      <% if (d.court) { %> · <strong><%= (days.find(([n]) => n === d.day) || [, `Day ${d.day}`])[1] %>, Poomsae court <%= d.court %></strong><% } %>
    </p>
    <% if (isAdmin) { %>
      <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/division" class="division-edit-row">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="hidden" name="division" value="<%= d.key %>">
        <label>Format
          <select name="format" <%= d.locked ? 'disabled' : '' %>>
            <option value="">Competition's: <%= POOMSAE_FORMATS[competition.poomsae_format] %></option>
            <% Object.entries(POOMSAE_FORMATS).forEach(([value, label]) => { %><option value="<%= value %>" <%= d.ownFormat && d.format === value ? 'selected' : '' %>><%= label %></option><% }) %>
          </select>
        </label>
        <label>Top into the bracket
          <input name="cut" type="number" min="2" max="<%= MAX_CUT %>" value="<%= d.ownCut ?? '' %>" placeholder="<%= competition.poomsae_cut %>" <%= d.locked ? 'disabled' : '' %>>
        </label>
        <label>Day
          <select name="day">
            <option value="">Any day</option>
            <% days.forEach(([value, label]) => { %><option value="<%= value %>" <%= d.pinnedDay === value ? 'selected' : '' %>><%= label %></option><% }) %>
          </select>
        </label>
        <button class="btn secondary small" type="submit">Save division</button>
        <% if (d.locked) { %><span class="hint">The format is fixed now that this division has a performance list, scores or a bracket.</span><% } %>
      </form>
    <% } %>
    <% const medalLine = ['gold', 'silver', 'bronze'].filter((m) => d.medalists[m].length > 0); %>
    <% if (medalLine.length > 0) { %>
      <p class="stats"><% medalLine.forEach((m) => { %><span><strong><%= m[0].toUpperCase() + m.slice(1) %>:</strong> <%= d.medalists[m].map((id) => names.get(id)).join(', ') %></span><% }) %></p>
    <% } %>

    <div class="table-wrap">
      <table>
        <thead><tr><% if (showScores) { %><th>Place</th><% } %><th>Athletes</th><th>Club</th><% if (showScores) { %><th>Score</th><% } %><% if (isAdmin) { %><th>Review</th><% } %></tr></thead>
        <tbody>
          <% d.entries.forEach((e) => { %>
            <tr id="entry-<%= e.id %>">
              <% if (showScores) { %>
                <td class="nowrap"><% if (e.place) { %><strong><%= placeText(e.place) %></strong><% if (d.mode === 'cut') { %><div class="hint"><%= e.place <= d.cut ? 'Qualified' : 'Out' %></div><% } %><% } else if (e.status === 'pending') { %><span class="badge pending">Pending</span><% } %></td>
              <% } %>
              <td><strong><%= e.names %></strong><div class="hint"><%= e.athletes.map((a) => `${beltName(a.belt_rank)}, ${a.age_at_event}`).join(' · ') %></div><% if (!showScores && e.status === 'pending') { %><span class="badge pending">Pending</span><% } %></td>
              <td><%= e.club_name %></td>
              <% if (showScores) { %>
                <td class="nowrap">
                  <% if (scoring && e.status === 'approved') { %>
                    <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/<%= e.id %>/score" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <input class="score-input" name="score" inputmode="decimal" autocomplete="off" value="<%= e.score === null ? '' : formatScore(e.score) %>" aria-label="Score of <%= e.names %>">
                      <button class="btn secondary small" type="submit">Save</button>
                    </form>
                  <% } else if (e.score !== null) { %><%= formatScore(e.score) %><% } %>
                </td>
              <% } %>
              <% if (isAdmin) { %>
                <td>
                  <% if (e.score !== null) { %><span class="hint">Scored</span>
                  <% } else if (d.bouts) { %><span class="hint">In a bracket</span>
                  <% } else if (e.perform_order !== null) { %><span class="hint">In the performance list</span>
                  <% } else { %>
                    <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/review" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <% if (e.status === 'pending') { %><button class="btn approve small" name="single" value="approved:<%= e.id %>" type="submit">Approve</button><% } %>
                      <input class="note-input" name="note_<%= e.id %>" maxlength="300" placeholder="Reason to reject" aria-label="Reason to reject <%= e.names %>">
                      <button class="btn danger small" name="single" value="rejected:<%= e.id %>" type="submit">Reject</button>
                    </form>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (closed && (d.mode === 'score' || d.mode === 'cut')) { %>
      <h3><%= d.mode === 'cut' ? 'Score round order' : 'Performance order' %></h3>
      <% if (d.order.length > 0) { %>
        <p class="sub"><% if (d.listCourt) { %><strong><%= (days.find(([n]) => n === d.listDay) || [, `Day ${d.listDay}`])[1] %>, Poomsae court <%= d.listCourt %></strong> · <% } %>drawn at random</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>#</th><th>Athletes</th><th>Club</th><th>Time</th></tr></thead>
            <tbody>
              <% d.order.forEach((e) => { %><tr><td class="num"><%= e.perform_order %></td><td><strong><%= e.names %></strong></td><td><%= e.club_name %></td><td class="nowrap"><%= e.perform_time || '' %></td></tr><% }) %>
            </tbody>
          </table>
        </div>
        <% if (isAdmin && d.canOrder) { %>
          <div class="actions">
            <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/order" data-confirm="Draw a new random order for this division?">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn secondary small" name="division" value="<%= d.key %>" type="submit">Redraw order</button>
            </form>
            <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/clear-order" data-confirm="Clear this performance list?">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn danger small" name="division" value="<%= d.key %>" type="submit">Clear list</button>
            </form>
          </div>
        <% } %>
      <% } else if (isAdmin && d.canOrder) { %>
        <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/order">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <p class="sub">Draws who performs first at random, and times it on the poomsae courts.</p>
          <button class="btn secondary" name="division" value="<%= d.key %>" type="submit">Make performance list</button>
        </form>
      <% } else if (d.pending > 0) { %>
        <p class="empty">Approve or reject the pending entries, then make the list.</p>
      <% } else { %>
        <p class="empty">No performance list yet.</p>
      <% } %>
    <% } %>

    <% if (d.mode !== 'score' && closed) { %>
      <h3>Bracket</h3>
      <% if (d.bouts) { %>
        <%- include('../partials/bracket', { division: d, highlightClubId: null }) %>
        <% const played = d.bouts.filter((b) => !b.isBye); %>
        <% if (played.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Bout</th><th>When</th><th>Blue</th><th>Red</th><th></th></tr></thead>
              <tbody>
                <% played.forEach((b) => { %>
                  <tr class="<%= b.winner ? 'result-row-done' : '' %>">
                    <td class="num"><strong><%= b.number %></strong></td>
                    <td class="nowrap"><%= b.time %></td>
                    <% [['blue', b.blue, b.bluePlaceholder], ['red', b.red, b.redPlaceholder]].forEach(([color, side, placeholder]) => { %>
                      <td>
                        <% if (!side) { %><span class="hint"><%= placeholder %></span>
                        <% } else if (b.winner) { %><% if (b.winner.registrationId === side.registrationId) { %><span class="badge approved">Winner</span> <strong><%= side.name %></strong><% } else { %><%= side.name %><% } %> <span class="hint"><%= side.club %></span>
                        <% } else if (b.blue && b.red) { %>
                          <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/bouts/<%= b.id %>">
                            <input type="hidden" name="_csrf" value="<%= csrf %>">
                            <button class="btn secondary small winner-choice" name="winner" value="<%= color %>" type="submit" aria-label="<%= side.name %> wins bout <%= b.number %>"><%= side.name %> <span class="hint"><%= side.club %></span></button>
                          </form>
                        <% } else { %><%= side.name %> <span class="hint"><%= side.club %></span><% } %>
                      </td>
                    <% }) %>
                    <td>
                      <% if (b.winner) { %>
                        <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/bouts/<%= b.id %>">
                          <input type="hidden" name="_csrf" value="<%= csrf %>">
                          <button class="btn danger small" name="action" value="clear" type="submit">Undo</button>
                        </form>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
        <% if (isAdmin && !d.bouts.some((b) => b.winner)) { %>
          <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/delete-bracket" data-confirm="Delete this bracket so it can be drawn again?">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn danger small" name="division" value="<%= d.key %>" type="submit">Delete bracket</button>
          </form>
        <% } %>
      <% } else if (d.pending > 0) { %>
        <p class="empty">Approve or reject the pending entries, then draw the bracket.</p>
      <% } else if (d.drawProblem) { %>
        <p class="empty"><%= d.drawProblem %></p>
      <% } else if (isAdmin) { %>
        <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/draw">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <p class="sub"><%= d.mode === 'cut' ? `The top ${d.cut} are seeded by their rank: 1st meets the lowest seed.` : 'Drawn at random, keeping entries from the same club apart where possible.' %></p>
          <button class="btn" name="division" value="<%= d.key %>" type="submit">Draw bracket</button>
        </form>
      <% } else { %>
        <p class="empty">The organiser draws this bracket.</p>
      <% } %>
    <% } %>
  </section>
<% }) %>

<% if (medals.length > 0) { %>
  <section class="card">
    <h2>Poomsae medal standings</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Club</th><th class="medal-count">Gold</th><th class="medal-count">Silver</th><th class="medal-count">Bronze</th></tr></thead>
        <tbody>
          <% medals.forEach((row) => { %>
            <tr>
              <td><span class="club-name"><%- include('../partials/club_icon', { clubId: row.clubId, name: row.club, size: 'sm' }) %><strong><%= row.club %></strong></span></td>
              <td class="medal-count"><%= row.gold %></td>
              <td class="medal-count"><%= row.silver %></td>
              <td class="medal-count"><%= row.bronze %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="hint">Ranked divisions give 1st, 2nd and 3rd place, shared on equal scores. In a bracket, both losing semifinalists get bronze, and an entry with no opponent gets no medal.</p>
  </section>
<% } %>

<% if (isAdmin && rejected.length > 0) { %>
  <section class="card">
    <h2>Rejected</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Athletes</th><th>Division</th><th>Club</th><th>Reason</th><th></th></tr></thead>
        <tbody>
          <% rejected.forEach((e) => { %>
            <tr id="entry-<%= e.id %>">
              <td><strong><%= e.names %></strong></td>
              <td><%= poomsaeDivisionTitle(e) %></td>
              <td><%= e.club_name %></td>
              <td><%= e.review_note %></td>
              <td>
                <form method="post" action="/admin/competitions/<%= competition.id %>/poomsae/review">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button class="btn secondary small" name="single" value="pending:<%= e.id %>" type="submit">Move back to pending</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
<% } %>
<%- include('../partials/bottom') %>
