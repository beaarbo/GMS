<%- include('../partials/top') %>
<p class="breadcrumb"><a href="/admin">Admin dashboard</a></p>
<div class="card narrow">
  <div class="title-row">
    <%- include('../partials/comp_logo', { competition, size: 'md' }) %>
    <h1>Delete <%= competition.name %>?</h1>
  </div>
  <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>

  <p>This permanently deletes the competition and everything in it:</p>
  <ul class="delete-list">
    <li><strong><%= footprint.registrations %></strong> registration<%= footprint.registrations === 1 ? '' : 's' %>, with weigh-in results</li>
    <li><strong><%= footprint.bouts %></strong> bout<%= footprint.bouts === 1 ? '' : 's' %> and <strong><%= footprint.results %></strong> recorded result<%= footprint.results === 1 ? '' : 's' %>, and the medal standings</li>
    <li>Its divisions, dates, logo and <strong><%= footprint.files %></strong> attached file<%= footprint.files === 1 ? '' : 's' %></li>
  </ul>
  <p class="sub">Athletes stay with their clubs, with their documents, and the activity log keeps its record of what happened.</p>

  <% if (backupsOn) { %>
    <div class="notice info">A backup of the whole database is made first. To undo, restore that backup (see Backups).</div>
  <% } else { %>
    <div class="notice error">Backups aren't set up on this server, so this can't be undone.</div>
  <% } %>

  <form method="post" action="/admin/competitions/<%= competition.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field">
      <label for="confirm_name">Type the competition's name to confirm</label>
      <input id="confirm_name" name="confirm_name" autocomplete="off" required>
      <p class="hint"><%= competition.name %></p>
    </div>
    <div class="actions">
      <button class="btn danger" type="submit">Delete competition</button>
      <a class="btn secondary" href="/admin">Cancel</a>
    </div>
  </form>
</div>
<%- include('../partials/bottom') %>
