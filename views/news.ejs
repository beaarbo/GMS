<%- include('partials/top') %>
<div class="page-head">
  <div>
    <h1>News</h1>
    <p class="sub">Updates from the organisers.</p>
  </div>
  <% if (user && user.role === 'admin') { %>
    <div class="actions">
      <a class="btn secondary" href="/admin/news">Manage posts</a>
      <a class="btn" href="/admin/news/new">New post</a>
    </div>
  <% } %>
</div>

<% if (posts.length === 0) { %>
  <div class="card"><p class="empty">No news yet. Check back soon.</p></div>
<% } %>

<% posts.forEach((post) => { %><%- include('partials/news_card', { post }) %><% }) %>
<%- include('partials/bottom') %>
