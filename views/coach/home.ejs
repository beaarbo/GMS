<%- include('../partials/top') %>
<div class="page-head">
  <div class="title-row">
    <% if (user.club_id) { %><%- include('../partials/club_icon', { clubId: user.club_id, name: user.club_name, size: 'lg' }) %><% } %>
    <div>
      <h1>Welcome<%= user.full_name ? `, ${user.full_name}` : '' %></h1>
      <p class="sub"><%= user.club_id ? user.club_name : 'You are not in a club yet.' %></p>
    </div>
  </div>
</div>

<% if (!user.club_id) { %>
  <%- include('../partials/empty', { message: 'An admin must approve you for a club before you can enter athletes.', href: '/coach', label: 'Join a club' }) %>
<% } else if (athletes) { %>
  <%# The club's athletes at a glance, with what still needs doing. %>
  <section class="card athletes-summary">
    <p><strong><%= athletes.total %></strong> athlete<%= athletes.total === 1 ? '' : 's' %><% if (needDocument && athletes.missing > 0) { %> · <strong><%= athletes.missing %></strong> need<%= athletes.missing === 1 ? 's' : '' %> a document before entering<% } %></p>
    <div class="actions">
      <a class="btn<%= athletes.total === 0 ? '' : ' secondary' %>" href="<%= athletes.total === 0 ? '/club/fighters/new' : '/club' %>"><%= athletes.total === 0 ? 'Add your first athlete' : 'Athletes' %></a>
    </div>
  </section>
<% } %>

<section class="section">
  <div class="section-head">
    <h2>Your competitions</h2>
    <a href="/">All competitions</a>
  </div>
  <% if (competitions.length === 0) { %>
    <%- include('../partials/empty', { message: 'No competitions are coming up yet. They appear here once the organiser opens registration.' }) %>
  <% } else { %>
    <div class="card-grid">
      <% competitions.forEach((c) => { %><%- include('../partials/competition_card', { c }) %><% }) %>
    </div>
  <% } %>
</section>

<section class="section">
  <div class="section-head">
    <h2>News</h2>
    <a href="/news">All news</a>
  </div>
  <% if (news.length === 0) { %>
    <div class="card"><p class="empty">No news yet.</p></div>
  <% } %>
  <% news.forEach((post) => { %><%- include('../partials/news_card', { post }) %><% }) %>
</section>
<%- include('../partials/bottom') %>
