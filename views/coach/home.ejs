<%- include('../partials/top') %>
<div class="page-head">
  <div class="title-row">
    <% if (user.club_id) { %><%- include('../partials/club_icon', { clubId: user.club_id, name: user.club_name, size: 'lg' }) %><% } %>
    <div>
      <h1>Welcome<%= user.full_name ? `, ${user.full_name}` : '' %></h1>
      <p class="sub"><%= user.club_id ? user.club_name : 'You are not in a club yet.' %></p>
    </div>
  </div>
  <% if (user.club_id) { %><a class="btn secondary" href="/club">Club dashboard</a><% } %>
</div>

<% if (!user.club_id) { %>
  <div class="notice info">An admin must approve you for a club before you can register athletes. <a href="/coach">Join a club</a></div>
<% } %>

<section class="section">
  <div class="section-head">
    <h2>Upcoming competitions</h2>
    <a href="/">All competitions</a>
  </div>
  <% if (competitions.length === 0) { %>
    <div class="card"><p class="empty">No upcoming competitions yet. Check back soon.</p></div>
  <% } else { %>
    <div class="card-grid">
      <% competitions.forEach((c) => { %><%- include('../partials/competition_card', { c }) %><% }) %>
    </div>
  <% } %>
</section>

<section class="section">
  <div class="section-head">
    <h2>News</h2>
    <a href="/news">All news</a>
  </div>
  <% if (news.length === 0) { %>
    <div class="card"><p class="empty">No news yet.</p></div>
  <% } %>
  <% news.forEach((post) => { %><%- include('../partials/news_card', { post }) %><% }) %>
</section>
<%- include('../partials/bottom') %>
