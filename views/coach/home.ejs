<%- include('../partials/top') %>
<div class="page-head">
  <div class="club-head">
    <% if (user.club_id) { %><%- include('../partials/club_icon', { clubId: user.club_id, name: user.club_name, size: 'lg' }) %><% } %>
    <div>
      <h1>Welcome<%= user.full_name ? `, ${user.full_name}` : '' %></h1>
      <p class="sub"><%= user.club_id ? user.club_name : 'You are not in a club yet.' %></p>
    </div>
  </div>
  <% if (user.club_id) { %><a class="btn secondary" href="/club">Club dashboard</a><% } %>
</div>

<% if (!user.club_id) { %>
  <div class="notice info">An admin must approve you for a club before you can register athletes. <a href="/coach">Join a club</a></div>
<% } %>

<section class="home-section">
  <h2>Upcoming competitions</h2>
  <% if (competitions.length === 0) { %>
    <div class="card"><p class="empty">No upcoming competitions yet. Check back soon.</p></div>
  <% } else { %>
    <div class="card-grid">
      <% competitions.forEach((c) => { const e = c.entries; const entered = e.pending + e.approved + e.rejected; %>
        <article class="card">
          <%- include('../partials/comp_logo', { competition: c, size: 'md' }) %>
          <p><span class="badge <%= c.open ? 'open' : 'closed' %>"><%= c.open ? `Open · ${timeLeft(c)}` : 'Registration closed' %></span></p>
          <h3><%= c.name %></h3>
          <p class="sub"><%= eventDatesText(c) %> · <%= c.venue %></p>
          <p class="sub">Registration deadline: <%= deadlineText(c) %></p>
          <% if (user.club_id) { %>
            <p class="stats home-entries">
              <% if (entered === 0) { %>
                <span>No athletes entered yet</span>
              <% } else { %>
                <span>Approved <strong><%= e.approved %></strong></span>
                <span>Pending <strong><%= e.pending %></strong></span>
                <% if (e.rejected > 0) { %><span>Rejected <strong><%= e.rejected %></strong></span><% } %>
              <% } %>
            </p>
          <% } %>
          <div class="actions">
            <% if (user.club_id && c.open) { %>
              <a class="btn" href="/club/competitions/<%= c.id %>">Register athletes</a>
            <% } else if (user.club_id && entered > 0) { %>
              <a class="btn secondary" href="/club/competitions/<%= c.id %>">Your entries</a>
            <% } %>
            <% if (user.club_id && c.bouts_published_at) { %>
              <a class="btn secondary" href="/club/competitions/<%= c.id %>/bouts">Bout list</a>
            <% } %>
            <a class="btn secondary" href="/competitions/<%= c.id %>">Details</a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="home-section">
  <div class="page-head">
    <h2>News</h2>
    <a href="/news">All news</a>
  </div>
  <% if (news.length === 0) { %>
    <div class="card"><p class="empty">No news yet.</p></div>
  <% } %>
  <% news.forEach((post) => { %>
    <article class="card news-item">
      <%- include('../partials/news_meta', { post }) %>
      <h3><a href="/news/<%= post.id %>"><%= post.title %></a></h3>
      <p><%= newsSummary(post.body) %></p>
      <a href="/news/<%= post.id %>">Read more</a>
    </article>
  <% }) %>
</section>
<%- include('../partials/bottom') %>
