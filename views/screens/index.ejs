<%- include('../partials/top') %>
<p class="breadcrumb"><% if (user.role === 'coach' && competition.bouts_published_at) { %><a href="/club/competitions/<%= competition.id %>/bouts">Bout list</a><% } else if (user.role === 'coach') { %><a href="/club/competitions/<%= competition.id %>/poomsae">Poomsae</a><% } else if (user.role === 'admin') { %><a href="/admin/competitions">Competitions</a><% } else { %><a href="/official">Competition day</a><% } %></p>
<div class="page-head">
  <div class="title-row">
    <%- include('../partials/comp_logo', { competition, size: 'md' }) %>
    <div>
      <h1>Court screens</h1>
      <p class="sub"><%= competition.name %> · Open one on a TV, tablet or phone. It updates live as results come in.</p>
    </div>
  </div>
</div>

<% if (days.length === 0) { %>
  <div class="card"><p class="empty">There's nothing on the courts yet.</p></div>
<% } %>
<% days.forEach((d) => { %>
  <section class="section">
    <div class="section-head"><h2><%= d.label %></h2></div>
    <div class="card-grid">
      <% if (d.courts.some((c) => c.kind === 'kyorugi')) { %>
        <article class="card">
          <h3 class="card-title">Call screen</h3>
          <p class="sub">The bouts called to the warm-up area, every court</p>
          <div class="actions">
            <a class="btn" href="/screens/<%= competition.id %>/calls/<%= d.day %>">Open screen</a>
            <% if (user.role !== 'coach') { %><a class="btn secondary" href="/admin/competitions/<%= competition.id %>/calls?day=<%= d.day %>">Call bouts</a><% } %>
          </div>
        </article>
      <% } %>
      <% d.courts.forEach((c) => { const poomsae = c.kind === 'poomsae'; %>
        <article class="card">
          <h3 class="card-title"><%= poomsae ? 'Poomsae court' : 'Court' %> <%= c.court %></h3>
          <p class="sub"><%= c.done %> of <%= c.total %> <%= poomsae ? 'performances and bouts' : 'bouts' %> finished</p>
          <div class="actions">
            <a class="btn" href="/screens/<%= competition.id %>/<%= poomsae ? 'poomsae/' : '' %><%= c.day %>/<%= c.court %>">Open screen</a>
            <% if (user.role !== 'coach') { %><a class="btn secondary" href="/admin/competitions/<%= competition.id %>/<%= poomsae ? 'poomsae/mat' : 'mat' %>/<%= c.day %>/<%= c.court %>">Record results</a><% } %>
            <% if (user.role !== 'coach' && poomsae && competition.poomsae_judges > 1) { %><a class="btn secondary" href="/admin/competitions/<%= competition.id %>/poomsae/mat/<%= c.day %>/<%= c.court %>#judges">Judge</a><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
<% }) %>
<%- include('../partials/bottom') %>
