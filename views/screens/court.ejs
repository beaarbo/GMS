<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# With JavaScript the page updates live as results come in. Without it, it reloads itself. %>
  <noscript><meta http-equiv="refresh" content="<%= refreshSeconds %>"></noscript>
  <title>Court <%= court %> · <%= competition.name %></title>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body class="screen" data-live-events="/screens/<%= competition.id %>/<%= day %>/<%= court %>/events">
<% const side = (bout, color) => { const f = bout[color]; return f ? { name: f.name, club: f.club, clubId: f.clubId } : { name: bout[`${color}Placeholder`] || 'To be decided', club: '' }; }; %>

<header class="screen-head">
  <div>
    <p class="screen-court">Court <%= court %></p>
    <p class="screen-sub"><%= competition.name %> · <%= dayLabel %></p>
  </div>
  <div class="screen-sub screen-right">
    <span class="screen-status" id="screen-status" hidden></span>
    <span data-live-part="progress"><%= done %> of <%= total %> bouts done<br>Updated <%= updatedAt %></span>
  </div>
</header>

<main class="screen-main" data-live-part="main">
  <section class="screen-now">
    <h1 class="screen-label">Now fighting</h1>
    <% if (now) { const blue = side(now, 'blue'); const red = side(now, 'red'); %>
      <p class="screen-bout">Bout <%= now.number %> · <%= now.time %> · <%= now.title %></p>
      <div class="screen-versus">
        <div class="screen-corner blue"><span class="screen-corner-label">Blue</span><% if (photos && photos.blue) { %><span class="screen-photos"><% photos.blue.forEach((p) => { %><%- include('../partials/athlete_photo', { url: p.url, name: p.name, size: 'xl' }) %><% }) %></span><% } %><strong><%= blue.name %></strong><span class="screen-club"><% if (blue.clubId) { %><%- include('../partials/club_icon', { clubId: blue.clubId, name: String(blue.club).replace(/^[A-Z]{3} · /, ''), size: 'md' }) %><% } %><%= blue.club %></span></div>
        <div class="screen-vs">vs</div>
        <div class="screen-corner red"><span class="screen-corner-label">Red</span><% if (photos && photos.red) { %><span class="screen-photos"><% photos.red.forEach((p) => { %><%- include('../partials/athlete_photo', { url: p.url, name: p.name, size: 'xl' }) %><% }) %></span><% } %><strong><%= red.name %></strong><span class="screen-club"><% if (red.clubId) { %><%- include('../partials/club_icon', { clubId: red.clubId, name: String(red.club).replace(/^[A-Z]{3} · /, ''), size: 'md' }) %><% } %><%= red.club %></span></div>
      </div>
    <% } else if (next.length > 0) { %>
      <p class="screen-empty">Waiting for earlier results.</p>
    <% } else { %>
      <p class="screen-empty">All bouts on this court are finished.</p>
    <% } %>
  </section>

  <div class="screen-columns">
    <section>
      <h2 class="screen-label">Up next</h2>
      <% if (next.length === 0) { %><p class="screen-empty">Nothing else on this court.</p><% } %>
      <ol class="screen-list">
        <% next.forEach((b) => { const blue = side(b, 'blue'); const red = side(b, 'red'); %>
          <li>
            <span class="screen-number"><%= b.number %></span>
            <div><strong><span class="blue-text"><%= blue.name %></span> vs <span class="red-text"><%= red.name %></span></strong><br><span class="screen-sub"><%= b.time %> · <%= b.title %></span></div>
          </li>
        <% }) %>
      </ol>
    </section>
    <section>
      <h2 class="screen-label">Recent results</h2>
      <% if (recent.length === 0) { %><p class="screen-empty">No results yet.</p><% } %>
      <ol class="screen-list">
        <% recent.forEach((b) => { %>
          <li>
            <span class="screen-number"><%= b.number %></span>
            <div><strong><%= b.winner.name %></strong> won<%= b.walkover ? ' by walkover' : '' %><% if (b.winType || b.score) { %> <span class="screen-sub">(<%= [b.winType, b.score].filter(Boolean).join(' ') %>)</span><% } %><br><span class="screen-sub"><%= b.winner.club %> · <%= b.title %></span></div>
          </li>
        <% }) %>
      </ol>
    </section>
  </div>
</main>
</body>
</html>
