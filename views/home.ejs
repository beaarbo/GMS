<%- include('partials/top') %>
<%# The front page: competitions first, then the latest news. %>
<section class="section">
  <div class="page-head">
    <div>
      <h1>Taekwondo competitions</h1>
      <p class="sub">Kyorugi and poomsae events open for club registration.</p>
    </div>
  </div>

  <% if (competitions.length === 0) { %>
    <div class="card"><p class="empty"><%= past.length > 0 ? 'No competitions are coming up right now. Check back soon.' : 'No competitions have been posted yet. Check back soon.' %></p></div>
  <% } else { %>
    <div class="card-grid">
      <% competitions.forEach((c) => { %><%- include('partials/competition_card', { c }) %><% }) %>
    </div>
  <% } %>
</section>

<section class="section" id="news">
  <div class="section-head">
    <h2>News</h2>
    <div class="actions">
      <% if (moreNews) { %><a href="/news">All news</a><% } %>
      <% if (user && user.role === 'admin') { %><a href="/admin/news">Manage posts</a><% } %>
    </div>
  </div>
  <% if (news.length === 0) { %>
    <div class="card"><p class="empty">No news yet. Check back soon.</p></div>
  <% } %>
  <% news.forEach((post) => { %><%- include('partials/news_card', { post }) %><% }) %>
</section>
<% if (past.length > 0) { %>
  <section class="section" id="past">
    <div class="section-head"><h2>Past competitions</h2></div>
    <ul class="past-list">
      <% past.forEach((c) => { %>
        <li>
          <%- include('partials/comp_logo', { competition: c, size: 'sm' }) %>
          <div class="past-text">
            <a class="title-link" href="/competitions/<%= c.id %>"><strong><%= c.name %></strong></a>
            <span class="sub"><%= eventDatesText(c) %> · <%= c.venue %></span>
          </div>
          <% if (c.hasResults) { %><a class="btn secondary small" href="/competitions/<%= c.id %>/results">Results</a><% } %>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>
<%- include('partials/bottom') %>
